+/* ---------- Rules main's full "+" menu needs (restored on sync) ---------- */
+.plus-menu__popup--flyout-contained .plus-menu__flyout .composer-design-toolbox-menu {
+  width: 100%;
+  min-width: 0;
+  max-width: 100%;
+}
+
+/* ---------- Plugins flyout: list + hover-preview column ---------- */
+/* The plugins flyout is wider than the others: the left column is the
+   familiar search + list, the right column mirrors the hovered row with
+   a live preview hero and metadata. Placement math reserves the extra
+   width via PLUS_MENU_PLUGIN_FLYOUT_WIDTH. */
+.plus-menu__flyout--plugins {
+  min-width: 0;
+  max-width: none;
+  width: 466px;
+  max-width: calc(100vw - 24px);
+  overflow: hidden;
+}
+
+/* Narrow surfaces (contained flyout) have no room for a side column, so
+   the preview drops below the list and the hero height is capped. */
+.plus-menu__popup--flyout-contained .plus-menu__flyout--plugins {
+  width: auto;
+}
+.plus-menu__popup--flyout-contained .plus-menu__plugin-pane {
+  flex-direction: column;
+}
+.plus-menu__popup--flyout-contained .plus-menu__plugin-main {
+  flex: 1 1 auto;
+  max-width: none;
+}
+
+/* The design-toolbox panel sits inside a flyout; give the flyout room and
+   let the panel's own styling (composer-design-toolbox-*) drive the rest. */
+.plus-menu__flyout .composer-design-toolbox-menu {
+  position: static;
+  width: auto;
+  min-width: 320px;
+  border: 0;
+  border-radius: 0;
+  box-shadow: none;
+  padding: 0;
+  background: transparent;
+}
+
+/* ── Composer mode picker (Plan / Design / Ask), left of the model selector ── */
+.composer-mode {
+  position: relative;
+  display: inline-flex;
+  /* Match the selected-state green to the "原型" template chip
+     (deep brand green #2f781d on the #f9fff4 tint). */
+  --green: #2f781d;
+  --green-bg: #f9fff4;
+}
+.composer-mode__trigger {
+  box-sizing: border-box;
+  width: 32px;
+  height: 32px;
+  padding: 0;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  border: 1px solid transparent;
+  border-radius: var(--radius-circular, 50%);
+  background: transparent;
+  color: var(--text-muted);
+  cursor: pointer;
+  transition:
+    background-color 140ms cubic-bezier(0.23, 1, 0.32, 1),
+    color 140ms cubic-bezier(0.23, 1, 0.32, 1);
+}
+.composer-mode__trigger:hover:not(:disabled),
+.composer-mode__trigger.is-open,
+.composer-mode__trigger.is-selected {
+  background: var(--bg-subtle);
+  color: var(--text);
+}
+.composer-mode__icon {
+  display: inline-flex;
+}
+.composer-mode__icon svg {
+  display: block;
+  /* 16px in both states — the unselected circular trigger previously ran the
+     glyph at 18px, a touch larger than the selected pill's 16px. */
+  width: 16px;
+  height: 16px;
+}
+/* Selected pill keeps the same 16px glyph as the neutral trigger
+   (dogfood 2026-07-28 icon-size pass). */
+.composer-mode.is-selected .composer-mode__icon svg {
+  width: 16px;
+  height: 16px;
+}
+/* In the home composer footer, match the "+" button chrome exactly: a 36px
+   circular outlined button (panel fill + border + soft shadow, muted glyph)
+   instead of the bare 32px borderless icon. */
+.home-hero__input-card .composer-mode__trigger {
+  width: 36px;
+  height: 36px;
+  min-width: 36px;
+  border-radius: var(--radius-circular, 50%);
+  background: var(--bg-panel);
+  border: 1px solid var(--border);
+  color: var(--text-muted);
+  box-shadow: var(--shadow-xs);
+}
+.home-hero__input-card .composer-mode__trigger:hover:not(:disabled),
+.home-hero__input-card .composer-mode__trigger.is-open {
+  outline: none;
+  background: var(--bg-panel);
+  border-color: var(--border-strong);
+  color: var(--text);
+}
+
+/* Selected state (Cursor-style): the circular icon button becomes a green
+   capsule — icon + mode name + a clear ×. The `.composer-mode` root holds the
+   pill fill; the trigger and clear button ride transparently on it. */
+.composer-mode.is-selected {
+  display: inline-flex;
+  align-items: center;
+  gap: 0;
+  padding: 0 4px 0 0;
+  border-radius: var(--radius-pill, 999px);
+  /* Neutral chip (dogfood 2026-07-28): no green plate, no green ring — the
+     selected mode reads in the same muted ink as the design-system palette
+     icon beside it. */
+  background: transparent;
+  box-shadow: none;
+}
+.home-hero__input-card .composer-mode.is-selected .composer-mode__trigger,
+.composer-mode.is-selected .composer-mode__trigger {
+  width: auto;
+  min-width: 0;
+  height: 34px;
+  gap: 6px;
+  padding: 0 6px 0 11px;
+  border: none;
+  border-radius: var(--radius-pill, 999px);
+  background: transparent;
+  box-shadow: none;
+  color: var(--text-muted);
+}
+.home-hero__input-card .composer-mode.is-selected .composer-mode__trigger:hover:not(:disabled),
+.composer-mode.is-selected .composer-mode__trigger:hover:not(:disabled),
+.composer-mode.is-selected .composer-mode__trigger.is-open {
+  background: transparent;
+  border: none;
+  color: var(--text);
+}
+.composer-mode__label {
+  font-size: 13px;
+  font-weight: 600;
+  line-height: 1;
+  white-space: nowrap;
+  color: var(--text-muted);
+}
+.composer-mode__clear {
+  appearance: none;
+  flex: 0 0 auto;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 20px;
+  height: 20px;
+  padding: 0;
+  border: none;
+  border-radius: var(--radius-pill, 999px);
+  background: transparent;
+  color: var(--text-muted);
+  cursor: pointer;
+  transition: background-color 120ms cubic-bezier(0.23, 1, 0.32, 1);
+}
+.composer-mode__clear:hover {
+  background: var(--bg-subtle);
+  color: var(--text);
+}
+
+.composer-mode-menu {
+  position: fixed;
+  z-index: 90;
+  display: flex;
+  flex-direction: column;
+  /* 2px between items so a hovered/selected row's fill sits clear of its
+     neighbours instead of butting against them. */
+  gap: 2px;
+  padding: 5px;
+  overflow-y: auto;
+  border: 1px solid var(--border-strong, var(--border));
+  border-radius: var(--radius-lg);
+  background: var(--bg-panel);
+  box-shadow:
+    0 1px 2px rgba(0, 0, 0, 0.04),
+    0 10px 28px -10px rgba(0, 0, 0, 0.18);
+}
+.composer-mode-menu__item {
+  appearance: none;
+  width: 100%;
+  /* Override the global `button { height: 36px }` — items grow to fit the
+     name + always-visible description. */
+  height: auto;
+  min-height: 0;
+  display: flex;
+  flex-direction: column;
+  align-items: stretch;
+  padding: 8px 9px;
+  border: 0;
+  border-radius: var(--radius);
+  background: transparent;
+  color: var(--text-strong);
+  font: inherit;
+  text-align: left;
+  cursor: pointer;
+  transition: background-color 140ms cubic-bezier(0.23, 1, 0.32, 1);
+}
+.composer-mode-menu__item:hover,
+.composer-mode-menu__item:focus-visible,
+.composer-mode-menu__item.is-selected {
+  outline: none;
+  background: var(--bg-subtle);
+}
+.composer-mode-menu__head {
+  display: flex;
+  align-items: center;
+  gap: 9px;
+}
+.composer-mode-menu__icon {
+  flex: 0 0 auto;
+  display: inline-flex;
+  opacity: 0.85;
+}
+.composer-mode-menu__icon svg {
+  display: block;
+  width: 16px;
+  height: 16px;
+}
+.composer-mode-menu__name {
+  font-size: 13px;
+  font-weight: 500;
+}
+/* Checkmark on the selected row, pushed to the right edge of the name line. */
+.composer-mode-menu__check {
+  margin-left: auto;
+  flex: 0 0 auto;
+  display: inline-flex;
+  color: var(--text);
+}
+/* Description sits under the name, always visible (aligned past the icon).
+   `min-width: 0` lets the flex item shrink so long text wraps inside the menu
+   width instead of overflowing to the right. */
+.composer-mode-menu__desc {
+  min-width: 0;
+  padding: 3px 0 0 25px;
+  font-size: 12px;
+  line-height: 1.45;
+  color: var(--text-muted);
+  white-space: normal;
+  overflow-wrap: break-word;
+}
